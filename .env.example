# Configuración del Servidor
PORT=4000
NODE_ENV=development

# Seguridad y Perímetro (Cloudflare & CORS)
FRONTEND_URL=http://localhost:3000
CLOUDFLARE_TRUST_PROXY=true

# Control de Tasa (Rate Limiting Anti-DDoS)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10

# Correo Corporativo de Notificaciones Sol Perú
CORPORATE_EMAIL=info@solperu.pe
